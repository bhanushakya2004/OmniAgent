    "/api/v1/stores/nearby": {
      "get": {
        "tags": [
          "Stores"
        ],
        "summary": "Find nearby physical stores",
        "description": "Retrieve nearby stores sorted by proximity for shopper mission selection.",
        "operationId": "get_nearby_stores_api_v1_stores_nearby_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90.0,
              "minimum": -90.0,
              "description": "Shopper latitude",
              "title": "Lat"
            },
            "description": "Shopper latitude"
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180.0,
              "minimum": -180.0,
              "description": "Shopper longitude",
              "title": "Lng"
            },
            "description": "Shopper longitude"
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 100.0,
              "exclusiveMinimum": 0,
              "default": 25.0,
              "title": "Radius Km"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StoreNearbyResponse"
                  },
                  "title": "Response Get Nearby Stores Api V1 Stores Nearby Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
