              "description": "Filter travel-size SKUs",
              "title": "Is Travel Size"
            },
            "description": "Filter travel-size SKUs"
          },
          {
            "name": "in_stock_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Filter in-stock SKUs only",
              "default": true,
              "title": "In Stock Only"
