# ==============================================================================
# OmniMission AI — Environment Configuration Example
# ==============================================================================

# Database
DATABASE_URL=postgresql+psycopg://omni:omni@localhost:5432/omnimission

# Security & Authentication
JWT_SECRET=change-me-to-a-very-secure-random-secret-key-32-chars-min
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3000

# Storage Port Configuration
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./.data/uploads

# AI & Gemini Configuration
GEMINI_BACKEND=api_key           # api_key | vertex
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=            # Phase 2 (GCP)
GOOGLE_CLOUD_LOCATION=us-central1 # Phase 2 (GCP)
GEMINI_MODEL_REASONING=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_VISION=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Tooling (Agno MCP Docs Server)
AGNO_MCP_TOKEN=

# Frontend Web Client
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
